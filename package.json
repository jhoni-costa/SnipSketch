{
  "name": "snipsketch",
  "displayName": "SnipSketch",
  "description": "Capture code snippets and annotate them with arrows, shapes, text, and highlights like Lightshot.",
  "version": "0.1.0",
  "publisher": "developer",
  "repository": {
    "type": "git",
    "url": "https://github.com/developer/snipsketch"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "screenshot",
    "capture",
    "lightshot",
    "snippet",
    "annotation",
    "draw",
    "arrow",
    "snipsketch"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:snipsketch.captureSelection",
    "onCommand:snipsketch.openEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "snipsketch.captureSelection",
        "title": "SnipSketch: Capture Selected Code",
        "category": "SnipSketch",
        "icon": "$(camera)"
      },
      {
        "command": "snipsketch.openEditor",
        "title": "SnipSketch: Open Screenshot Editor",
        "category": "SnipSketch",
        "icon": "$(edit)"
      }
    ],
    "keybindings": [
      {
        "command": "snipsketch.captureSelection",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "snipsketch.captureSelection",
          "group": "1_modification@100",
          "when": "editorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "snipsketch.captureSelection",
          "when": "true"
        },
        {
          "command": "snipsketch.openEditor",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "SnipSketch",
      "properties": {
        "snipsketch.theme": {
          "type": "string",
          "default": "one-dark-pro",
          "enum": [
            "one-dark-pro",
            "dracula",
            "github-dark",
            "monokai",
            "nord"
          ],
          "description": "Default code theme for captured snippets."
        },
        "snipsketch.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show line numbers in code capture."
        },
        "snipsketch.showWindowControls": {
          "type": "boolean",
          "default": true,
          "description": "Show macOS window controls (traffic light dots)."
        },
        "snipsketch.padding": {
          "type": "number",
          "default": 32,
          "description": "Padding around the code card (in pixels)."
        },
        "snipsketch.fontFamily": {
          "type": "string",
          "default": "JetBrains Mono, Fira Code, Menlo, Monaco, 'Courier New', monospace",
          "description": "Font family for code rendering."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "highlight.js": "^11.9.0",
    "typescript": "^5.3.3"
  }
}
